# Graphiti HTTP Bridge Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for bridge
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    neo4j \
    python-dotenv \
    graphiti-core \
    pydantic

# Copy bridge source
COPY src/memorystack/bridges/ ./bridges/
COPY .env.mcp.example .env

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run the bridge
CMD ["python", "-m", "uvicorn", "bridges.graphiti_http_bridge:app", "--host", "0.0.0.0", "--port", "5000"]
