# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
OPENAI_ORG_ID=  # Optional

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Google Gemini (Optional)
GOOGLE_API_KEY=

# Groq (Optional)
GROQ_API_KEY=

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Graphiti MCP Configuration
GRAPHITI_MCP_COMMAND=npx @getzep/mcp-server-graphiti
GRAPHITI_MCP_ENABLED=true

# Memory Configuration
MEMORY_SEARCH_LIMIT=10
MEMORY_MIN_RELEVANCE=0.7
MEMORY_AUTO_STORE=true

# Model Routing
DEFAULT_MODEL=gpt-4-turbo
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=claude-3-5-sonnet
CODING_MODEL=gpt-4

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=3600

# Persona Configuration
DEFAULT_PERSONA=default
PERSONA_ISOLATION=true

# Cost Tracking
TRACK_COSTS=true
COST_ALERT_THRESHOLD=50.0

# CORS (para produção, especifique domínios)
CORS_ORIGINS=*
