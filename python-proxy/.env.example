# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# Default LLM Provider (can be overridden via X-Provider-URL header)
DEFAULT_PROVIDER_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# OpenAI API Key (REQUIRED for Tier 2 fact extraction)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# MCP/Graphiti Endpoints
# Adjust these if your MCP server runs on different host/port
MCP_SEARCH_ENDPOINT=http://localhost:5000/mcp/search
MCP_STORE_ENDPOINT=http://localhost:5000/mcp/store

# Memory Configuration
MEMORY_ENABLED=true
MEMORY_SEARCH_LIMIT=5

# Memory Optimization
# Max tokens for memory context (prevents exceeding context window)
MEMORY_MAX_CONTEXT_TOKENS=2000

# Chunk size for storing long memories (in tokens)
MEMORY_CHUNK_SIZE=500

# Memory Backend Selection
# Options: "graphiti" (graph-based with Neo4j) or "supermemory" (vector-based)
MEMORY_BACKEND=graphiti

# Supermemory Configuration (only if MEMORY_BACKEND=supermemory)
# For cloud: https://api.supermemory.ai
# For self-hosted: http://localhost:8080
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
# API key (only needed for cloud, leave empty for self-hosted)
SUPERMEMORY_API_KEY=

# Conversational Cache Settings (NEW!)
# Enables intelligent caching of memory searches (80-90% hit rate)
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=900
CACHE_SIMILARITY_THRESHOLD=0.85

# User Profile Settings (NEW!)
# Always inject user context (who you are, your goals, etc)
PROFILE_ENABLED=true
PROFILES_DIR=profiles

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS (set specific domains in production)
CORS_ORIGINS=*

# LangGraph Agent Orchestration (Experimental)
# Enable LangGraph V4 for intelligent agent-based memory routing
# Provides parallel retrieval, context adaptation, and better local model support
# Set to true to enable, false to use V3 (default: false for stability)
LANGGRAPH_ENABLED=false

# Local Model Endpoints (Optional)
# Override default local model URLs by model type
# Default fallback: http://localhost:11434/v1 (Ollama)
# LOCAL_MODEL_URL=http://localhost:11434/v1
# LOCAL_MISTRAL_URL=http://localhost:11964/v1
# LOCAL_LLAMA_URL=http://localhost:11434/v1
# LOCAL_QWEN_URL=http://localhost:11434/v1
# LOCAL_COGITO_URL=http://localhost:8080/v1
# LOCAL_LAS_URL=http://localhost:5000/v1
