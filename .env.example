# MemoryStack Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: OpenAI API Key (for Tier 2 fact extraction)
# ============================================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8000
DEBUG=false
LOG_LEVEL=info
HOST=0.0.0.0

# ============================================================================
# Memory Backend Selection
# ============================================================================
# Choose: "graphiti" or "supermemory"
MEMORY_BACKEND=graphiti
MEMORY_ENABLED=true

# ============================================================================
# Redis Configuration (Tier 1 & 2)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# Tier 1: Working Memory (Recent conversations)
# ============================================================================
# Default turns optimized to 10 for best performance (90% of queries)
WORKING_MEMORY_TURNS=10
WORKING_MEMORY_TTL=1800  # 30 minutes

# ============================================================================
# Tier 2: Session Memory (Extracted facts)
# ============================================================================
SESSION_MEMORY_MODEL=gpt-4o-mini
SESSION_MEMORY_TTL=86400  # 24 hours

# ============================================================================
# Tier 3: Graphiti + Neo4j (if using graphiti backend)
# ============================================================================
GRAPHITI_ENABLED=true
GRAPHITI_URL=http://localhost:5000

# MCP Endpoints (HTTP Bridge)
MCP_SEARCH_ENDPOINT=http://localhost:5000/mcp/search
MCP_STORE_ENDPOINT=http://localhost:5000/mcp/store

# Neo4j Database
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
GROUP_ID=memorystack

# Memory Settings
MEMORY_SEARCH_LIMIT=5
MEMORY_CHUNK_SIZE=500
MEMORY_MAX_CONTEXT_TOKENS=2000

# ============================================================================
# Tier 3: Supermemory (if using supermemory backend)
# ============================================================================
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_API_KEY=your-supermemory-key

# ============================================================================
# Features
# ============================================================================
# Conversational Cache (80-90% hit rate)
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=900  # 15 minutes
CACHE_SIMILARITY_THRESHOLD=0.85

# User Profiles
PROFILE_ENABLED=true
PROFILES_DIR=profiles

# Progressive Injection (77% token reduction)
PROGRESSIVE_INJECTION=true

# ============================================================================
# LLM Provider Defaults
# ============================================================================
DEFAULT_PROVIDER_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# ============================================================================
# Security & Rate Limiting
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*

# ============================================================================
# Quick Setup Guides
# ============================================================================
#
# 1. SIMPLEST SETUP (Supermemory backend):
#    - Set MEMORY_BACKEND=supermemory
#    - Fill in OPENAI_API_KEY and SUPERMEMORY_API_KEY
#    - Start: docker-compose up -d
#
# 2. GRAPHITI SETUP (Graph-based memory):
#    - Set MEMORY_BACKEND=graphiti
#    - Fill in OPENAI_API_KEY, NEO4J_URI, NEO4J_PASSWORD
#    - Start: docker-compose --profile graphiti up -d
#
# 3. LOCAL DEVELOPMENT:
#    - Copy this file: cp .env.example .env
#    - Edit .env with your values
#    - Start services: ./scripts/start.sh
#
# For more help: https://github.com/joaolvivas/memorystack/docs
